{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nothing X Windows",
  "mainBinaryName": "Nothing X Windows",
  "identifier": "com.nothingxwin.app",
  "app": {
    "windows": [
      {
        "label": "popover",
        "url": "index.html",
        "title": "Nothing X Windows",
        "width": 300,
        "height": 360,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
