{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nothing X Mac",
  "mainBinaryName": "Nothing X Mac",
  "version": "../package.json",
  "identifier": "com.nothingxmac.app",
  "build": {
    "frontendDist": "../web",
    "additionalWatchFolders": ["../web"]
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "category": "Utility",
    "copyright": "Made by Yash Raut · yashraut.me"
  }
}
